# Backend Server Port and Host
HOST=127.0.0.1
PORT=8000

# Google Colab Public URL (e.g. from ngrok: https://xxxx-xx-xx.ngrok-free.app)
# Paste your active ngrok URL generated when running the Colab notebook
COLAB_API_URL=https://your-colab-tunnel-url.ngrok-free.app

# Timeout in seconds for deep vision-language model inference on high-res images
COLAB_TIMEOUT_SECONDS=180

# Mock Mode Fallback:
# If set to true, when Colab is offline or not yet connected, the backend returns
# realistic verified clinical zero-shot extraction data for demonstration & testing
FALLBACK_TO_MOCK_IF_OFFLINE=true

# Allowed CORS Origins (Frontend URL)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

